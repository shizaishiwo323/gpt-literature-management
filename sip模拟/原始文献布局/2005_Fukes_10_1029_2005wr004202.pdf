            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Relationship between spectral induced polarization and hydraulic properties of saturated and unsaturated sandstone</rdf:li>
            </rdf:Alt>
         </dc:title>
