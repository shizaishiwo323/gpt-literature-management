      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Hydrology: Soil moisture; Physical Properties of Rocks: Wave attenuation; Hydrology: Instruments and techniques: modeling</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Effects of Maxwell&amp;hyphen;Wagner polarization on soil complex dielectric permittivity under variable temperature and electrical conductivity</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Yongping Chen, Dani Or</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
