            <rdf:Alt>
               <rdf:li xml:lang="x-default">Hydrology: Soil moisture; Physical Properties of Rocks: Permeability and porosity; Electromagnetics: Numerical methods</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geometrical factors and interfacial processes affecting complex dielectric permittivity of partially saturated porous media</rdf:li>
            </rdf:Alt>
         </dc:title>
